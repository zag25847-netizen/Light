{
  "manifest_version": 3,
  "name": "Phishing Detector AI",
  "version": "2.0",
  "description": "Detect phishing websites using Random Forest",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://phishing-detector-api-bx66.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "warning.css"
      ],
      "run_at": "document_idle"
    }
  ]
}